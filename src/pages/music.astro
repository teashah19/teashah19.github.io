---
import Layout from '../layouts/Layout.astro';
import SpotifyPlayer from '../components/SpotifyPlayer.astro';
---

<Layout>
	<section class="music-page animate-fade-in-up">
		<div class="mb-10">
			<h1 class="text-4xl font-extrabold text-slate-900 mb-2">🎵 My Music</h1>
			<p class="text-slate-600">Currently spinning from my Spotify library</p>
		</div>

		<SpotifyPlayer />

		<div class="mt-16 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
			<h2 class="text-2xl font-bold text-slate-900 mb-6">🎧 How this works</h2>
			<p class="text-slate-600 leading-relaxed mb-4">
				This section pulls from your Spotify library using the Spotify Web API.
				To connect your actual music data, you'll need:
			</p>
			<ol class="list-decimal list-inside text-slate-600 space-y-2">
				<li>A Spotify Developer account (<a href="https://developer.spotify.com/dashboard" class="text-indigo-600 hover:underline" target="_blank">create an app</a>)</li>
				<li>Client ID and Client Secret from your Spotify app dashboard</li>
				<li>Environment variables: <code class="bg-slate-100 px-2 py-0.5 rounded">SPOTIFY_CLIENT_ID</code> and <code class="bg-slate-100 px-2 py-0.5 rounded">SPOTIFY_CLIENT_SECRET</code></li>
				<li>OAuth redirect URI set to your site's callback route</li>
			</ol>
			<p class="mt-4 text-slate-500 text-sm">
				Currently showing a placeholder. Add your Spotify credentials to see your real library.
			</p>
		</div>
	</section>
</Layout>