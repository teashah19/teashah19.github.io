---
interface Props {
  rating: number;
}

const { rating } = Astro.props as Props;

const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 !== 0;
const emptyStars = 5 - Math.ceil(rating);
---

<div class="flex items-center gap-1" aria-label="Rating: {rating} out of 5">
	{[...Array(fullStars)].map((_, i) => (
		<span class="text-yellow-400" aria-hidden="true">★</span>
	))}
	{hasHalfStar ? <span class="text-yellow-400" aria-hidden="true">⯪</span> : null}
	{[...Array(emptyStars)].map((_, i) => (
		<span class="text-slate-200" aria-hidden="true">★</span>
	))}
	<span class="ml-1 text-xs text-slate-500">({rating})</span>
</div>

<style>
	span {
		line-height: 1;
	}
</style>
